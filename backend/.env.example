DATABASE_URL=postgresql://username:password@localhost:5432/guardianiq

SECRET_KEY=replace_with_secret_key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Phase 2 Scheduler Configurations ---
# Enable the background scheduler worker processes
SCHEDULER_ENABLED=false

# Feature flag to enable Phase 2 API routes (Set to true to expose endpoints)
PHASE2_SCHEDULER_ENABLED=false

# Polling interval for checking due schedules (in seconds)
SCHEDULER_POLL_INTERVAL_SECONDS=60

# Max schedules to process in one polling cycle
SCHEDULER_MAX_SCHEDULES_PER_CYCLE=25

# Unique identifier for this worker instance (useful in multi-instance setups)
SCHEDULER_WORKER_ID=worker-node-1

# Logging format (TEXT or JSON) and Level (INFO, DEBUG, ERROR)
LOG_LEVEL=INFO
LOG_FORMAT=JSON